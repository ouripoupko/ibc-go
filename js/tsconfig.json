{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
